{
  "name": "@wookbot/streamdeck-ts-viewer",
  "version": "1.0.0",
  "description": "display Teamspeak clients on your streamdeck",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --fix",
    "check": "biome check --fix"
  },
  "author": "Lukas Müller",
  "license": "ISC",
  "trustedDependencies": [
    "@biomejs/biome",
    "@julusian/jpeg-turbo",
    "node-hid",
    "sharp"
  ],
  "dependencies": {
    "@elgato-stream-deck/node": "6.2.2",
    "@julusian/jpeg-turbo": "2.2.0",
    "@tanstack/query-core": "5.59.6",
    "immer": "10.1.1",
    "is-online": "^9.0.1",
    "node-hid": "^3.1.0",
    "p-wait-for": "^3.2.0",
    "sharp": "^0.33.5",
    "ts3-nodejs-library": "3.5.1",
    "winston": "3.15.0",
    "wretch": "2.10.0",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.3",
    "@types/bun": "^1.1.13",
    "@types/ws": "8.5.12",
    "typescript": "5.6.2"
  }
}
