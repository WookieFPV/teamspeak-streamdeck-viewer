{
  "name": "@wookbot/streamdeck-ts-viewer",
  "version": "1.0.0",
  "description": "display Teamspeak clients on your streamdeck",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target node --format cjs --external sharp --external node-hid --external cpu-features",
    "start-prod": "bun dist/index.js",
    "build-watch": "bun run build --watch",
    "start-watch": "bun --watch dist/index.js",
    "start": "concurrently \"bun run build-watch\" \"bun run start-watch\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --fix",
    "check": "biome check --fix",
    "check-ci": "biome ci"
  },
  "author": "Lukas Müller",
  "license": "ISC",
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@biomejs/biome",
    "node-hid",
    "sharp"
  ],
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.3",
    "dotenv": "17.4.2",
    "node-hid": "^3.4.0",
    "sharp": "^0.35.4",
    "ts3-nodejs-library": "3.5.3",
    "winston": "3.19.0",
    "zod": "4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.4.1",
    "bun-types": "^1.4.2",
    "concurrently": "10.0.5",
    "typescript": "5.9.3"
  }
}
