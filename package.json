{
  "name": "@wookbot/streamdeck-ts-viewer",
  "version": "1.0.0",
  "description": "display Teamspeak clients on your streamdeck",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "start-prod": "node dist/index.js",
    "build-watch": "tsup --watch",
    "start-watch": "nodemon dist/index.js",
    "start": "concurrently \"pnpm build-watch\" \"pnpm start-watch\"",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --fix",
    "check": "biome check --fix",
    "check-ci": "biome ci"
  },
  "author": "Lukas Müller",
  "license": "ISC",
  "engines": {
    "node": ">=18.12"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@julusian/jpeg-turbo",
      "esbuild",
      "node-hid",
      "sharp"
    ]
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.3",
    "@julusian/jpeg-turbo": "^3.0.1",
    "@tanstack/query-core": "5.102.8",
    "dotenv": "16.6.1",
    "immer": "10.2.0",
    "is-online": "^12.0.2",
    "node-hid": "^3.4.0",
    "p-wait-for": "^3.2.0",
    "sharp": "^0.35.4",
    "ts3-nodejs-library": "3.5.3",
    "winston": "3.19.0",
    "wretch": "2.11.1",
    "ws": "^8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.4",
    "nodemon": "^3.1.14",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
