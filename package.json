{
  "name": "@wookbot/streamdeck-ts-viewer",
  "version": "1.0.0",
  "description": "display Teamspeak clients on your streamdeck",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "start-prod": "node dist/index.js",
    "build-watch": "tsup --watch",
    "start-watch": "nodemon dist/index.js",
    "start": "concurrently \"pnpm build-watch\" \"pnpm start-watch\"",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --fix",
    "check": "biome check --fix",
    "check-ci": "biome ci"
  },
  "author": "Lukas Müller",
  "license": "ISC",
  "engines": {
    "node": ">=18.12"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@julusian/jpeg-turbo",
      "esbuild",
      "node-hid",
      "sharp"
    ]
  },
  "dependencies": {
    "@elgato-stream-deck/node": "6.2.2",
    "@julusian/jpeg-turbo": "2.2.0",
    "@tanstack/query-core": "5.59.6",
    "dotenv": "16.4.5",
    "immer": "10.1.1",
    "is-online": "^9.0.1",
    "node-hid": "^3.1.0",
    "p-wait-for": "^3.2.0",
    "sharp": "^0.33.5",
    "ts3-nodejs-library": "3.5.1",
    "winston": "3.15.0",
    "wretch": "2.10.0",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "20.11.5",
    "@types/ws": "8.5.12",
    "concurrently": "9.0.1",
    "nodemon": "^3.1.7",
    "tsup": "8.3.0",
    "typescript": "5.6.2"
  }
}
