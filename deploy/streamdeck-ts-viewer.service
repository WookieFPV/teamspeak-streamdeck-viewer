[Unit]
# systemd unit for the production device (raspberry pi, bun).
# Install: see deploy/README.md
Description=TeamSpeak Stream Deck viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/streamdeck-ts-viewer

# bun's install dir must be on PATH; systemd does not read the user's profile.
Environment=PATH=/home/pi/.bun/bin:/usr/local/bin:/usr/bin:/bin

# bun is started directly against dist/index.js (already bundled, native addons external)
# rather than through `bun run start-prod`, to keep exactly one process as the systemd-managed PID.
# The append redirect keeps ~/streamdeck.log as the stdout mirror without truncating history on
# each start (the app also writes a rotating file via winston - see src/utils/logger.ts - so this
# is just the journald-bypass copy; stdout additionally lands in the journal).
ExecStart=/bin/sh -c 'exec bun dist/index.js >> /home/pi/streamdeck.log 2>&1'

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
