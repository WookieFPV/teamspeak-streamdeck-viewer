# Pick BACKEND_TYPE customApi or ts3
# customApi needs a special backend, ts3 needs only a ts3 server

# Only for BACKEND_TYPE=customApi
# BACKEND_TYPE=customApi
# BACKEND_URL=https://myUrl.de/api
# BACKEND_WS_URL=wss://myUrl.de/api/ws
# BACKEND_TOKEN=token


# Only for BACKEND_TYPE=ts3
BACKEND_TYPE=ts3
TS3_HOST=1.2.3.4
TS3_PASSWORD=password
TS3_NICKNAME=queryUsername
TS3_USERNAME=queryUsername
# Optional, defaults are the TeamSpeak server defaults:
# TS3_QUERYPORT=10011
# TS3_SERVERPORT=9987

#Always needed:
TS3_MAIN_USER_UID=userIdOfMainUser
STREAMDECK_FONT=DejaVuSans
STREAMDECK_USER_FONTSIZE=16
STREAMDECK_AFK_FONTSIZE=14

#Optional: shorten long nicknames on the keys ("exact name=short;..."):
# NICKNAME_MAPPING=FK1024 | Felix=Felix;N1m4=Nima
# pin one deck when several are plugged in (hid path, see listStreamDecks output)
# STREAMDECK_PATH=
# override the assets dir (default: <cwd>/assets - process must start at repo root)
# STREAMDECK_ASSETS_DIR=
# override the rotating app log file (default: <cwd>/streamdeck.log)
# LOG_FILE=
# override the dotenv file (default: <cwd>/.env)
# DOTENV_PATH=
